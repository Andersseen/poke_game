---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout>
    <!-- Header -->
    <header class="fixed top-0 w-full z-20 flex justify-between items-center px-4 md:px-8 py-4 bg-transparent pointer-events-none">
        
        <!-- Left: Back Button & Theme Toggle -->
        <div class="flex gap-4 pointer-events-auto">
             <button id="back-btn" class="neu-icon-btn w-12 h-12 md:w-14 md:h-14 opacity-0 transition-opacity duration-300" aria-label="Back to Menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </button>
            
            <button id="theme-btn" class="neu-icon-btn w-12 h-12 md:w-14 md:h-14" aria-label="Toggle Theme">
                <!-- Sun Icon (for Dark Mode) -->
                <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <!-- Moon Icon (for Light Mode) -->
                <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                </svg>
            </button>
        </div>

        <!-- Stats (Right Side) -->
        <div class="neu-panel px-6 py-2 flex gap-6 items-center pointer-events-auto">
             <div class="flex flex-col items-center">
                <span class="text-xs font-light opacity-60 uppercase tracking-widest">Lvl</span>
                <span id="level" class="text-lg font-bold">1</span>
            </div>
            <div class="w-px h-8 bg-current opacity-20"></div>
            <div class="flex flex-col items-center w-24">
                <span class="text-xs font-light opacity-60 uppercase tracking-widest">Time</span>
                <span id="time" class="text-sm font-bold font-mono">--:--</span>
            </div>
        </div>
    </header>

    <main class="relative w-full min-h-screen flex flex-col items-center justify-center overflow-hidden p-4">
        <!-- Title (Menu Only) -->
        <h1 id="game-title" class="text-5xl md:text-7xl font-bold mb-8 neu-text transition-all duration-500 select-none text-neu tracking-wider opacity-80">
            JUEGO
        </h1>

        <!-- Game Board Container -->
        <div id="pokes" class="poke__container flex flex-wrap items-center justify-center max-w-[900px] w-full gap-6 perspective-1000 z-10">
            <!-- Cards injected via JS -->
        </div>

        <!-- Menu / Popup Overlay -->
        <div id="menu" class="absolute inset-0 z-0 flex flex-col items-center justify-center transition-all duration-500">
             <div class="h-32"></div>

            <section class="neu-panel p-8 md:p-12 flex flex-col items-center gap-8 max-w-sm w-full mx-4 transition-transform duration-300">
                <h5 class="text-lg uppercase opacity-60 tracking-widest text-center">Select Level</h5>
                
                <div class="flex justify-center gap-6 w-full">
                    <button id="level_1" class="neu-icon-btn w-16 h-16 text-2xl font-bold text-neu active:scale-95 level-btn" data-level="1">1</button>
                    <button id="level_2" class="neu-icon-btn w-16 h-16 text-2xl font-bold text-neu active:scale-95 level-btn" data-level="2">2</button>
                    <button id="level_3" class="neu-icon-btn w-16 h-16 text-2xl font-bold text-neu active:scale-95 level-btn" data-level="3">3</button>
                </div>
                
                <button id="start-btn" class="neu-panel px-12 py-4 text-xl font-bold tracking-wider hover:text-[var(--primary)] transition-colors active:shadow-inner active:neu-pressed w-full">
                    START
                </button>
            </section>
        </div>

        <!-- Result Popup -->
         <div id="result-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/20 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
            <div class="neu-panel p-10 flex flex-col items-center gap-6">
                 <h2 class="text-3xl font-bold text-[var(--success)] text-neu">YOU WON!</h2>
                 <p class="opacity-70">Ready for the next challenge?</p>
                 <button id="restart-btn" class="neu-panel px-10 py-3 text-lg font-bold hover:text-[var(--primary)] active:neu-pressed">
                    PLAY AGAIN
                </button>
            </div>
         </div>
    </main>

    <!-- Audio Elements -->
    <audio src="/assets/sounds/success.wav" class="sound" id="sound__success" preload="auto"></audio>
    <audio src="/assets/sounds/card.wav" class="sound" id="sound__card" preload="auto"></audio>
    <audio src="/assets/sounds/error.wav" class="sound" id="sound__error" preload="auto"></audio>
    <audio src="/assets/sounds/open.wav" class="sound" id="sound__start" preload="auto"></audio>
    <audio src="/assets/sounds/level.wav" class="sound" id="sound__level" preload="auto" loop></audio>
    <audio src="/assets/sounds/good_end.wav" class="sound" id="sound__good-end" preload="auto"></audio>
</Layout>

<script>
    // Theme Switcher Logic
    const themeBtn = document.getElementById('theme-btn');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');
    const html = document.documentElement;

    // Check saved theme
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        html.classList.add('dark');
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
    }

    themeBtn?.addEventListener('click', () => {
        html.classList.toggle('dark');
        const isDark = html.classList.contains('dark');
        
        if (isDark) {
            sunIcon?.classList.remove('hidden');
            moonIcon?.classList.add('hidden');
            localStorage.setItem('theme', 'dark');
        } else {
            sunIcon?.classList.add('hidden');
            moonIcon?.classList.remove('hidden');
            localStorage.setItem('theme', 'light');
        }
    });

    // Level Button Logic
    const levelBtns = document.querySelectorAll('.level-btn');
    levelBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            levelBtns.forEach(b => {
                b.classList.remove('neu-pressed');
                b.classList.add('neu-icon-btn');
                b.style.color = 'var(--foreground)';
            });
            const target = e.target as HTMLElement;
            target.classList.remove('neu-icon-btn');
            target.classList.add('neu-pressed');
            target.style.color = 'var(--primary)';
        });
    });
    // Set level 1 active by default
    document.getElementById('level_1')?.click();
</script>
