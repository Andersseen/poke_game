---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// We will handle logic in client-side scripts
---

<Layout>
    <header class="fixed w-full max-h-[50px] z-20 flex justify-around items-center bg-white/10 backdrop-blur-sm shadow-sm md:max-h-[70px]">
        <h2 class="header__text text-gray-600/60 font-zen uppercase text-xl md:text-2xl pt-1 tracking-widest select-none">Time: <span id="time" class="font-bold"></span></h2>
        <h1 class="header__text text-gray-800 font-zen uppercase text-3xl md:text-5xl font-semibold select-none">Juego</h1>
        <h3 class="header__text text-gray-600/60 font-zen uppercase text-lg md:text-2xl font-light select-none">Lvl: <span id="level">1</span></h3>
    </header>

    <main class="main pt-[50px] bg-gradient-to-r from-[#e4a26c] to-[#c7aae4] relative w-full min-h-screen flex flex-col items-center justify-center overflow-hidden">
        <div id="pokes" class="poke__container flex flex-wrap items-center justify-center max-w-[800px] w-full p-4 gap-4 perspective-1000">
            <!-- Cards will be injected by JS -->
        </div>

        <!-- Initial/Popup Overlay -->
        <div id="table" class="fixed inset-0 z-10 bg-gradient-to-r from-[#e4a26c] to-[#c7aae4] flex flex-col items-center justify-center transition-all duration-500">
            <section class="popup bg-white/30 backdrop-blur-md p-10 rounded-2xl shadow-xl flex flex-col items-center gap-8 max-w-md w-full mx-4">
                <div class="popup__wrapper flex flex-col items-center gap-6 w-full">
                    <h5 class="text-xl uppercase text-white drop-shadow-md text-center">Do you want change level?</h5>
                    <div class="flex flex-row justify-around w-full gap-4">
                        <span id="level_1" class="level-btn w-12 h-12 flex items-center justify-center border-4 border-[#deebed] text-2xl rounded-xl bg-[#e4d2d2] cursor-pointer hover:-translate-y-1 hover:shadow-lg active:translate-y-0.5 active:shadow-sm transition-all text-[#585151]">1</span>
                        <span id="level_2" class="level-btn w-12 h-12 flex items-center justify-center border-4 border-[#deebed] text-2xl rounded-xl bg-[#e4d2d2] cursor-pointer hover:-translate-y-1 hover:shadow-lg active:translate-y-0.5 active:shadow-sm transition-all text-[#585151]">2</span>
                        <span id="level_3" class="level-btn w-12 h-12 flex items-center justify-center border-4 border-[#deebed] text-2xl rounded-xl bg-[#e4d2d2] cursor-pointer hover:-translate-y-1 hover:shadow-lg active:translate-y-0.5 active:shadow-sm transition-all text-[#585151]">3</span>
                    </div>
                </div>
                
                <div id="start-btn" class="btn bg-[#e4d2d2] text-[#585151] border-4 border-[#deebed] px-8 py-3 text-2xl rounded-2xl shadow-lg cursor-pointer hover:-translate-y-1 hover:shadow-xl active:translate-y-0.5 active:shadow-md transition-all uppercase tracking-wider w-full text-center select-none">
                    Start
                </div>
                
                <div id="restart-btn" class="btn hidden bg-[#e4d2d2] text-[#585151] border-4 border-[#deebed] px-8 py-3 text-2xl rounded-2xl shadow-lg cursor-pointer hover:-translate-y-1 hover:shadow-xl active:translate-y-0.5 active:shadow-md transition-all uppercase tracking-wider w-full text-center select-none">
                    Restart?
                </div>
            </section>
        </div>
    </main>

    <!-- Audio Elements -->
    <audio src="/assets/sounds/success.wav" class="sound" id="sound__success" preload="auto"></audio>
    <audio src="/assets/sounds/card.wav" class="sound" id="sound__card" preload="auto"></audio>
    <audio src="/assets/sounds/error.wav" class="sound" id="sound__error" preload="auto"></audio>
    <audio src="/assets/sounds/open.wav" class="sound" id="sound__start" preload="auto"></audio>
    <audio src="/assets/sounds/level.wav" class="sound" id="sound__level" preload="auto" loop></audio>
    <audio src="/assets/sounds/good_end.wav" class="sound" id="sound__good-end" preload="auto"></audio>
</Layout>
